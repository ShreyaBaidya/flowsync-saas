# ─────────────────────────────────────────────
#  FlowSync Server — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/flowsync
# Production:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flowsync?retryWrites=true&w=majority

# ── CORS (comma-separated allowed origins) ────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_string_for_access
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_string_for_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ───────────────────────────────────
# Refresh token cookie max-age in ms (default: 7 days)
COOKIE_MAX_AGE=604800000

# ── Bcrypt ────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────
LOG_LEVEL=debug
# Options: error | warn | info | http | debug
