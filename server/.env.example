# ─────────────────────────────────────────────────────────────
#  FlowSync API — Environment Variables
#  Copy this file to .env and fill in all values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
# Port the HTTP server listens on.
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Full MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/flowsync
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/flowsync
MONGODB_URI=mongodb://127.0.0.1:27017/flowsync

# ── JWT ───────────────────────────────────────────────────────
# Secrets must be long, random, and unique per environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_long_random_hex_string
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_hex_string

# How long the access token is valid.
# Format: https://github.com/vercel/ms  (e.g. 15m, 1h, 7d)
ACCESS_TOKEN_EXPIRES_IN=15m

# How long the refresh token is valid.
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# URL of the frontend — used for CORS origin and cookie settings.
# No trailing slash.
CLIENT_URL=http://localhost:3000

# ── Cookies ───────────────────────────────────────────────────
# Set to true in production (requires HTTPS).
# Set to false for local HTTP development.
COOKIE_SECURE=false

# SameSite policy for the refresh token cookie.
# Allowed values: strict | lax | none
# Use "lax" for local dev, "strict" for production same-origin.
# "none" requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
NODE_ENV=development